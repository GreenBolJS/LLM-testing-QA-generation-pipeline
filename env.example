# .env.example — copy this file to .env and fill in your actual keys.
#
#   cp .env.example .env
#
# Then load it before running the pipeline, e.g.:
#   export $(grep -v '^#' .env | xargs)
# or use python-dotenv / direnv / your shell's preferred .env loader.
#
# Never commit your real .env file — it should stay out of version control.

# Groq API key, used by src/generator.py for QA generation
# (model: llama-3.1-8b-instant). Get a free-tier key at https://console.groq.com
GROQ_API_KEY=

# Hugging Face access token, used by src/verifier.py for faithfulness
# verification via Inference Providers (model: google/gemma-3-27b-it).
# Get a free token at https://huggingface.co/settings/tokens
# (a "read" scope token is sufficient)
HF_TOKEN=
